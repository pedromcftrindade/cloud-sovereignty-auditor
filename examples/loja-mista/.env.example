# All values are fake. A real .env is never committed (see .gitignore).

# Email
SENDGRID_API_KEY=FAKE_KEY_0001
SMTP_HOST=smtp.sendgrid.net

# Error tracking (the part before @ is a key: ExitPilot never stores it)
SENTRY_DSN=https://fakepublickey0000@o0000.ingest.sentry.io/0000

# Payments
STRIPE_SECRET_KEY=FAKE_KEY_0002

# Shipping partner: deliberately NOT in the services catalog
SHIPPING_API_URL=https://api.parcelpartner-demo.eu/v1

# Internal addresses: must never be reported
S3_ENDPOINT=http://minio:9000
ADMIN_PANEL=http://10.0.0.12:8080
# Disabled: STRIPE_WEBHOOK_URL=https://hooks.stripe.com/old
