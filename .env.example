# Copy this file to .env and fill in your key. NEVER commit .env (it is in .gitignore).
# Free key: console.mistral.ai -> "Experiment" plan (phone verification required).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Set to 1 to never call the API and only use cached answers (demo without internet).
EXITPILOT_OFFLINE=0
