# Copy this file to .env and fill in what you need. NEVER commit .env (it is in .gitignore).

# Which LLM does the AI work: "ollama" (a model on this machine, recommended for the demo),
# "mistral" (Mistral's API), "lmstudio" or "local" (any OpenAI-compatible server: set LLM_BASE_URL).
# Without any of this everything still works: template text for your projects, and for the example
# projects the AI answers recorded in demo/ai_answers.json (python -m exitpilot.record).
LLM_PROVIDER=ollama

# --- Ollama (LLM_PROVIDER=ollama) ---
# The model of "ollama run mistral". Ollama must be running (the app/service, or `ollama serve`).
LLM_MODEL=mistral
# LLM_BASE_URL=http://localhost:11434
# Context window in tokens: long prompts are cut silently if it is too small. Lower it if RAM is short.
LLM_NUM_CTX=8192
# Seconds per request. A CPU-only laptop is slow: record the cache before the demo (see README).
LLM_TIMEOUT=300

# --- Mistral API (LLM_PROVIDER=mistral) ---
# Free key: console.mistral.ai -> "Experiment" plan (phone verification required).
# The free plan may use your requests for training: use fictitious data only.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Other local servers (LLM_PROVIDER=lmstudio | local | ollama-openai) ---
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_JSON_MODE=0

# Set to 1 to never call any model and only use cached answers (demo without a model running).
EXITPILOT_OFFLINE=0
# Recorded answers replayed for the examples when no model is reachable. 0 = ignore them.
# EXITPILOT_RECORDED=demo/ai_answers.json
