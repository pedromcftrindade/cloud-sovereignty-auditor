# Copy this file to .env and fill in what you need. NEVER commit .env (it is in .gitignore).

# Which LLM writes the report text: "mistral" (default), or a model server on your own machine:
# "lmstudio" (http://localhost:1234/v1), "ollama" (http://localhost:11434/v1) or "local" (any server
# with an OpenAI-compatible API: set LLM_BASE_URL). Without any of this the report still works
# (template text).
LLM_PROVIDER=mistral

# --- Mistral API ---
# Free key: console.mistral.ai -> "Experiment" plan (phone verification required).
# The free plan may use your requests for training: use fictitious data only.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Local model server (LLM_PROVIDER=lmstudio | ollama | local) ---
# Model name exactly as the server lists it. Set it: the cache is keyed by the model name,
# so record the cache and run the demo with the same one.
LLM_MODEL=
# LLM_BASE_URL=http://localhost:1234/v1
# Seconds per request (default 180). A CPU-only machine is slow.
# LLM_TIMEOUT=180
# Ollama accepts response_format json_object; LM Studio does not (leave it off there).
# LLM_JSON_MODE=0

# Set to 1 to never call any model and only use cached answers (demo without internet).
EXITPILOT_OFFLINE=0
