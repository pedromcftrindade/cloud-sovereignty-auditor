{
  "_about": "ExitPilot lock-in catalog. Part 1 'categories': what each kind of service is and its European/open-source alternatives (written once). Part 2 'types' + 'prefixes': which category and lock-in level each Terraform type has (one line per provider type). Levels: 0 = standard, exists everywhere; 1 = compatible with a common standard; 2 = managed service with an open-source equivalent; 3 = proprietary, no direct equivalent.",

  "categories": {
    "compute":              {"label": "Virtual machines",            "support": false, "effort": "low",    "leaseweb": "Leaseweb Public Cloud instance or dedicated server", "alternatives": ["Any European IaaS provider (VMs are a standard)"], "what_changes": "Re-create the VM from the same OS image; the application does not change."},
    "disk":                 {"label": "Block storage (disks)",       "support": false, "effort": "low",    "leaseweb": "Volumes attached to the Leaseweb instance", "alternatives": ["Any IaaS provider"], "what_changes": "Copy the data; no code changes."},
    "object_storage":       {"label": "Object storage",              "support": false, "effort": "low",    "leaseweb": "Leaseweb Object Storage (S3-compatible API)", "alternatives": ["S3-compatible object storage from a European provider", "Ceph RGW or Garage (self-hosted, open source)"], "what_changes": "Change the endpoint and credentials; S3 client code keeps working."},
    "file_storage":         {"label": "Shared file storage (NFS)",   "support": false, "effort": "low",    "leaseweb": "NFS server on a Leaseweb instance", "alternatives": ["NFS (open standard)"], "what_changes": "Copy the files and remount; no code changes."},
    "database":             {"label": "Managed SQL database",        "support": false, "effort": "medium", "leaseweb": "PostgreSQL / MySQL installed on a Leaseweb instance (automated in phase 2)", "alternatives": ["PostgreSQL", "MySQL / MariaDB"], "what_changes": "Dump and restore the data; the application only changes the connection string. Backups and patching become your responsibility (automated in phase 2)."},
    "proprietary_database": {"label": "Proprietary database",        "support": false, "effort": "high",   "leaseweb": "PostgreSQL (JSONB) or another open-source database on a Leaseweb instance", "alternatives": ["PostgreSQL (JSONB)", "Apache Cassandra"], "what_changes": "The data model and every query in the application must be rewritten."},
    "cache":                {"label": "In-memory cache",             "support": false, "effort": "medium", "leaseweb": "Valkey / Redis on a Leaseweb instance", "alternatives": ["Valkey (open-source Redis fork)", "Redis"], "what_changes": "Point the application to the new host; same protocol."},
    "messaging":            {"label": "Queues, topics and streams",  "support": false, "effort": "medium", "leaseweb": "RabbitMQ or Apache Kafka on a Leaseweb instance", "alternatives": ["RabbitMQ", "Apache Kafka", "NATS"], "what_changes": "Replace the provider SDK calls with a standard client (AMQP / Kafka)."},
    "serverless":           {"label": "Serverless functions",        "support": false, "effort": "high",   "leaseweb": "Containers on Leaseweb instances (e.g. with OpenFaaS or Knative)", "alternatives": ["OpenFaaS", "Knative", "A small container service"], "what_changes": "Package each function as a container and replace provider-specific triggers and events."},
    "containers":           {"label": "Proprietary container platform", "support": false, "effort": "medium", "leaseweb": "Docker / Kubernetes on Leaseweb instances", "alternatives": ["Kubernetes", "Docker Compose"], "what_changes": "Container images stay the same; the deployment definitions must be rewritten."},
    "kubernetes":           {"label": "Kubernetes cluster",          "support": false, "effort": "low",    "leaseweb": "Kubernetes on Leaseweb instances", "alternatives": ["Any conformant Kubernetes"], "what_changes": "Kubernetes manifests are portable; only storage and load balancer classes change."},
    "container_registry":   {"label": "Container registry",          "support": false, "effort": "low",    "leaseweb": "Harbor on a Leaseweb instance", "alternatives": ["Harbor (open source)"], "what_changes": "Push the same images to the new registry (OCI standard)."},
    "api_gateway":          {"label": "API gateway",                 "support": false, "effort": "medium", "leaseweb": "Traefik / NGINX on a Leaseweb instance", "alternatives": ["Traefik", "NGINX", "Kong (open source)"], "what_changes": "Re-create routes and auth rules; clients keep the same URLs if DNS moves."},
    "identity":             {"label": "End-user login (identity)",   "support": false, "effort": "high",   "leaseweb": "Keycloak on a Leaseweb instance", "alternatives": ["Keycloak (open source)"], "what_changes": "User accounts must be migrated; password hashes usually cannot be exported, so users may have to reset passwords."},
    "load_balancer":        {"label": "Load balancer",               "support": false, "effort": "low",    "leaseweb": "Leaseweb load balancer or HAProxy / NGINX", "alternatives": ["HAProxy", "NGINX"], "what_changes": "Re-create listeners and health checks."},
    "dns":                  {"label": "DNS zone",                    "support": false, "effort": "low",    "leaseweb": "Any DNS provider (records are a standard)", "alternatives": ["Any European DNS provider", "PowerDNS (open source)"], "what_changes": "Export and import the zone file."},
    "cdn":                  {"label": "CDN",                         "support": false, "effort": "low",    "leaseweb": "Leaseweb CDN", "alternatives": ["Any European CDN"], "what_changes": "Re-create the distribution and switch DNS."},
    "secrets":              {"label": "Keys and secrets management", "support": false, "effort": "medium", "leaseweb": "OpenBao on a Leaseweb instance", "alternatives": ["OpenBao (open-source fork of Vault)"], "what_changes": "Re-create secrets; provider-managed encryption keys cannot be exported, so data encrypted with them must be re-encrypted."},
    "monitoring":           {"label": "Monitoring and logs",         "support": true,  "effort": "medium", "leaseweb": "Prometheus + Grafana on a Leaseweb instance", "alternatives": ["Prometheus", "Grafana", "OpenSearch"], "what_changes": "Re-create dashboards and alerts."},
    "workflow":             {"label": "Workflow orchestration",      "support": false, "effort": "high",   "leaseweb": "Temporal or Apache Airflow on a Leaseweb instance", "alternatives": ["Temporal", "Apache Airflow"], "what_changes": "Workflow definitions use a proprietary language and must be rewritten."},
    "search":               {"label": "Search engine",               "support": false, "effort": "low",    "leaseweb": "OpenSearch on a Leaseweb instance", "alternatives": ["OpenSearch"], "what_changes": "Snapshot and restore the indexes."},
    "analytics":            {"label": "Data warehouse / analytics",  "support": false, "effort": "high",   "leaseweb": "ClickHouse or PostgreSQL on Leaseweb instances", "alternatives": ["ClickHouse", "PostgreSQL", "Apache Spark"], "what_changes": "Queries use a proprietary SQL dialect and pipelines must be rebuilt."},
    "ai_ml":                {"label": "AI / ML platform",            "support": false, "effort": "high",   "leaseweb": "Self-hosted open-weight models on Leaseweb GPU servers", "alternatives": ["Open-weight models (e.g. Mistral) served with vLLM"], "what_changes": "Training and serving pipelines are proprietary and must be rebuilt."},
    "web_app_platform":     {"label": "Managed web app hosting",     "support": false, "effort": "medium", "leaseweb": "Container or VM on Leaseweb", "alternatives": ["Docker", "Coolify / Dokku (open source)"], "what_changes": "Package the app as a container; configuration and deployment slots change."},

    "network":              {"label": "Network (VPC, subnets, routes, IPs)", "support": true, "effort": "low", "leaseweb": "Leaseweb private networking", "alternatives": ["Re-created on the target provider"], "what_changes": "Re-created as part of the migration."},
    "firewall":             {"label": "Firewall rules",              "support": true,  "effort": "low",    "leaseweb": "Leaseweb firewall / security rules", "alternatives": ["Re-created on the target provider"], "what_changes": "Re-created as part of the migration (and reviewed)."},
    "permissions":          {"label": "Permissions (IAM)",           "support": true,  "effort": "medium", "leaseweb": "Target provider's access control", "alternatives": ["Re-designed on the target provider"], "what_changes": "Provider-specific policies must be redesigned."},
    "configuration":        {"label": "Configuration of another resource", "support": true, "effort": "low", "leaseweb": "-", "alternatives": ["-"], "what_changes": "Migrated together with the main resource."},
    "certificates":         {"label": "TLS certificates",            "support": true,  "effort": "low",    "leaseweb": "Let's Encrypt or your own certificates", "alternatives": ["Let's Encrypt"], "what_changes": "Issue new certificates."}
  },

